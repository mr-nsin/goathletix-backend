# Backend (NestJS) environment sample.
# Copy this file to `.env` and fill in real values. Do NOT commit the real `.env`.

# Postgres / Supabase pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Port the NestJS server listens on.
PORT=4000

# Optional: enable the Supabase REST client (leave unset to fall back to Prisma).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
