generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditlog {
  user_id      String   @db.Uuid
  audio_s3_url String?  @db.VarChar
  transcript   String   @db.VarChar
  parsed_json  String   @db.VarChar
  id           String   @id @db.Uuid
  created_at   DateTime @db.Timestamp(6)
  user         user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brokercredential {
  user_id            String  @db.Uuid
  fyers_app_id       String? @db.VarChar
  fyers_access_token String? @db.VarChar
  id                 String  @id @db.Uuid
  user               user    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order {
  user_id         String  @db.Uuid
  broker_order_id String? @db.VarChar
  symbol          String  @db.VarChar
  side            String  @db.VarChar
  quantity        Int
  status          String  @db.VarChar
  is_algo_trade   Boolean
  id              String  @id @db.Uuid
  user            user    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user {
  email             String             @unique(map: "ix_user_email") @db.VarChar
  subscription_tier String             @db.VarChar
  id                String             @id @db.Uuid
  created_at        DateTime           @db.Timestamp(6)
  auditlog          auditlog[]
  brokercredential  brokercredential[]
  order             order[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model virtualportfolio {
  id               Int   @id @default(autoincrement())
  total_capital    Float
  available_margin Float
  realized_pnl     Float
  unrealized_pnl   Float
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model virtualtrade {
  id            String    @id @db.Uuid
  strategy_name String    @db.VarChar
  symbol        String    @db.VarChar
  side          String    @db.VarChar
  quantity      Int
  entry_price   Float
  exit_price    Float?
  status        String    @db.VarChar
  pnl           Float
  created_at    DateTime  @db.Timestamp(6)
  closed_at     DateTime? @db.Timestamp(6)
}

// ==========================================
// GoAthletix Event Discovery Models
// ==========================================

model Organizer {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  websiteUrl String?  @map("website_url")
  logoUrl    String?  @map("logo_url")
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  events     Event[]
  follows    Follow[]

  @@map("organizers")
}

model Event {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String                                 @unique @map("source_id")
  eventName       String                                 @map("event_name")
  sportType       SportCategory                          @map("sport_type")
  startDate       DateTime                               @map("start_date") @db.Date
  endDate         DateTime?                              @map("end_date") @db.Date
  city            String
  state           String
  venue           String
  geoLocation     Unsupported("geography(Point, 4326)")? @map("geo_location")
  distanceOptions String[]                               @map("distance_options")
  elevationGain   String?                                @map("elevation_gain")
  difficulty      DifficultyLevel                        @default(Intermediate)
  priceRange      String?                                @map("price_range")
  registrationUrl String                                 @map("registration_url")
  posterUrl       String?                                @map("poster_url")
  isPopular       Boolean                                @default(false) @map("is_popular")
  description     String?
  slug            String?                                @unique
  ageCategories   AgeCategory[]                          @map("age_categories")
  disciplineSlugs String[]                               @map("discipline_slugs")
  seriesId        String?                                @map("series_id") @db.Uuid
  series          EventSeries?                           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  clubId          String?                                @map("club_id") @db.Uuid
  club            Club?                                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  isClubActivity  Boolean                                @default(false) @map("is_club_activity")
  organizerName   String?                                @map("organizer_name")
  registrationOpensAt  DateTime?                         @map("registration_opens_at") @db.Timestamptz(6)
  registrationClosesAt DateTime?                         @map("registration_closes_at") @db.Timestamptz(6)
  interestCount   Int                                    @default(0) @map("interest_count")
  viewCount       Int                                    @default(0) @map("view_count")
  organizerId     String?                                @map("organizer_id") @db.Uuid
  organizer       Organizer?                             @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  terrain         String?
  isVirtual       Boolean                                @default(false) @map("is_virtual")
  status          EventStatus                            @default(upcoming)
  md5PayloadHash  String                                 @map("md5_payload_hash")
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)
  follows         Follow[]
  userCalendars   UserCalendar[]
  reminders       Reminder[]
  interests       EventInterest[]
  results         EventResult[]

  @@map("events")
}

model Profile {
  id                  String          @id @db.Uuid
  fullName            String?         @map("full_name")
  preferredLocation   String?         @map("preferred_location")
  sportsInterest      SportCategory[] @map("sports_interest")
  onboardingCompleted Boolean         @default(false) @map("onboarding_completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  follows             Follow[]
  userCalendars       UserCalendar[]
  reminders           Reminder[]
  eventRequests       EventRequest[]
  feedbacks           UserFeedback[]
  activityLogs        ActivityLog[]
  eventInterests      EventInterest[]
  eventResults        EventResult[]
  entityFollows       EntityFollow[]
  clubMemberships     ClubMember[]
  ownedClubs          Club[]           @relation("ClubOwner")
  ownedCenters        TrainingCenter[] @relation("CenterOwner")
  sharedCalendars     SharedCalendar[]

  @@map("profiles")
}

model Follow {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  FollowTarget @map("target_type")
  organizerId String?      @map("organizer_id") @db.Uuid
  organizer   Organizer?   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  eventId     String?      @map("event_id") @db.Uuid
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, organizerId], name: "unique_user_follow_organizer")
  @@unique([userId, eventId], name: "unique_user_follow_event")
  @@map("follows")
}

model UserCalendar {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, eventId], name: "unique_user_event_calendar")
  @@map("user_calendars")
}

model Reminder {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     String       @map("event_id") @db.Uuid
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggerType ReminderType @map("trigger_type")
  isTriggered Boolean      @default(false) @map("is_triggered")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, eventId, triggerType], name: "unique_user_event_reminder")
  @@map("reminders")
}

model EventRequest {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  profile         Profile?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName       String        @map("event_name")
  sportType       SportCategory @map("sport_type")
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  city            String
  state           String
  venue           String
  registrationUrl String        @map("registration_url")
  description     String?
  organizerName   String        @map("organizer_name")
  status          RequestStatus @default(pending)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("event_requests")
}

model UserFeedback {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  profile      Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  feedbackType FeedbackType @map("feedback_type")
  message      String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("user_feedbacks")
}

model ActivityLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  profile         Profile?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userDisplayName String?        @map("user_display_name")
  actionType      ActivityAction @map("action_type")
  targetId        String         @map("target_id") @db.Uuid
  targetName      String         @map("target_name")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("activity_logs")
}

enum SportCategory {
  running
  cycling
  triathlon
  trekking
  fitness
  racquet
  water
  adventure
  // Added 2026-09-16 by migration 0005 (ADR-006). Order matches pg_enum sort order; Postgres
  // cannot reorder or remove enum values, so append only.
  athletics
  skating
  gymnastics
  martial_arts
  team_sports
  mind_sports

  @@map("sport_category")
}

enum EventStatus {
  upcoming
  closed
  completed
  cancelled

  @@map("event_status")
}

enum DifficultyLevel {
  Beginner
  Intermediate
  Advanced
  Expert

  @@map("difficulty_level")
}

enum FollowTarget {
  organizer
  event

  @@map("follow_target")
}

enum ReminderType {
  registration_open
  registration_close
  event_date

  @@map("reminder_type")
}

enum RequestStatus {
  pending
  approved
  rejected

  @@map("request_status")
}

enum FeedbackType {
  feature_request
  general_feedback
  bug_report

  @@map("feedback_type")
}

enum ActivityAction {
  save
  follow
  calendar_add

  @@map("activity_action")
}

// ---------------------------------------------------------------------------
// Taxonomy, clubs and engagement — migrations 0006-0011 (ADR-006).
// ---------------------------------------------------------------------------

enum SportFamily {
  athletics
  endurance
  skill_artistic
  combat
  racquet
  outdoor
  fitness
  team
  mind

  @@map("sport_family")
}

enum EventModel {
  mass_participation
  meet
  bracket
  batch_departure
  non_competitive
  league_fixture

  @@map("event_model")
}

enum DisciplineKind {
  sport
  format

  @@map("discipline_kind")
}

enum AgeCategory {
  kids
  sub_junior
  junior
  youth
  open
  masters

  @@map("age_category")
}

enum RecurrenceKind {
  none
  weekly
  monthly
  seasonal
  annual

  @@map("recurrence_kind")
}

enum ClubRole {
  owner
  admin
  member

  @@map("club_role")
}

enum MembershipStatus {
  pending
  active
  left
  removed

  @@map("membership_status")
}

enum InterestStatus {
  saved
  interested
  going
  attended
  skipped

  @@map("interest_status")
}

enum FollowEntity {
  event
  organizer
  club
  training_center
  user

  @@map("follow_entity")
}

model Sport {
  slug        SportCategory @id
  displayName String        @map("display_name")
  family      SportFamily
  eventModel  EventModel    @map("event_model")
  phase       Int           @default(9) @db.SmallInt
  isActive    Boolean       @default(false) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  disciplines Discipline[]
  series      EventSeries[]

  @@map("sports")
}

model Discipline {
  slug        String         @id
  displayName String         @map("display_name")
  sportType   SportCategory  @map("sport_type")
  sport       Sport          @relation(fields: [sportType], references: [slug])
  kind        DisciplineKind @default(sport)
  aliases     String[]
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("disciplines")
}

model EventSeries {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String?        @unique
  description    String?
  sportType      SportCategory  @map("sport_type")
  sport          Sport          @relation(fields: [sportType], references: [slug])
  recurrence     RecurrenceKind @default(none)
  recurrenceNote String?        @map("recurrence_note")
  clubId         String?        @map("club_id") @db.Uuid
  club           Club?          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  events         Event[]

  @@map("event_series")
}

model Club {
  id                String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  slug              String                                 @unique
  description       String?
  sportTypes        SportCategory[]                        @map("sport_types")
  disciplineSlugs   String[]                               @map("discipline_slugs")
  ageCategories     AgeCategory[]                          @map("age_categories")
  city              String
  state             String
  meetingPoint      String?                                @map("meeting_point")
  geoLocation       Unsupported("geography(Point, 4326)")? @map("geo_location")
  logoUrl           String?                                @map("logo_url")
  coverUrl          String?                                @map("cover_url")
  websiteUrl        String?                                @map("website_url")
  instagramUrl      String?                                @map("instagram_url")
  whatsappInviteUrl String?                                @map("whatsapp_invite_url")
  contactEmail      String?                                @map("contact_email")
  ownerId           String?                                @map("owner_id") @db.Uuid
  owner             Profile?                               @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isVerified        Boolean                                @default(false) @map("is_verified")
  isActive          Boolean                                @default(true) @map("is_active")
  memberCount       Int                                    @default(0) @map("member_count")
  createdAt         DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)
  members           ClubMember[]
  events            Event[]
  series            EventSeries[]

  @@map("clubs")
}

model ClubMember {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId    String           @map("club_id") @db.Uuid
  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String           @map("user_id") @db.Uuid
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ClubRole         @default(member)
  status    MembershipStatus @default(active)
  joinedAt  DateTime         @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([clubId, userId], map: "unique_club_member")
  @@map("club_members")
}

model EventInterest {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String         @map("event_id") @db.Uuid
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  status    InterestStatus @default(saved)
  note      String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, eventId], map: "unique_user_event_interest")
  @@map("event_interests")
}

model EventResult {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  user             Profile                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId          String                   @map("event_id") @db.Uuid
  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryEntered  String?                  @map("category_entered")
  bibNumber        String?                  @map("bib_number")
  // Postgres `interval` has no native Prisma mapping, so it stays Unsupported: reachable by raw
  // query only. EventsService uses Supabase REST, so nothing in the app path needs it typed.
  finishTime       Unsupported("interval")? @map("finish_time")
  positionOverall  Int?                     @map("position_overall")
  positionCategory Int?                     @map("position_category")
  isPersonalBest   Boolean                  @default(false) @map("is_personal_best")
  isVerified       Boolean                  @default(false) @map("is_verified")
  notes            String?
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("event_results")
}

model EntityFollow {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FollowEntity @map("target_type")
  // No relation: the target spans five tables. Integrity is held by the delete triggers in
  // migrations 0009 and 0010, which is the accepted trade for a table that never changes shape.
  targetId   String       @map("target_id") @db.Uuid
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, targetType, targetId], map: "unique_entity_follow")
  @@map("entity_follows")
}

model SharedCalendar {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  user             Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareToken       String           @unique @map("share_token")
  title            String           @default("My season")
  includedStatuses InterestStatus[] @map("included_statuses")
  seasonYear       Int?             @map("season_year")
  isPublic         Boolean          @default(true) @map("is_public")
  viewCount        Int              @default(0) @map("view_count")
  expiresAt        DateTime?        @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("shared_calendars")
}

model TrainingCenter {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String                                 @unique
  description     String?
  sportTypes      SportCategory[]                        @map("sport_types")
  disciplineSlugs String[]                               @map("discipline_slugs")
  ageCategories   AgeCategory[]                          @map("age_categories")
  city            String
  state           String
  address         String?
  geoLocation     Unsupported("geography(Point, 4326)")? @map("geo_location")
  contactPhone    String?                                @map("contact_phone")
  contactEmail    String?                                @map("contact_email")
  websiteUrl      String?                                @map("website_url")
  logoUrl         String?                                @map("logo_url")
  coverUrl        String?                                @map("cover_url")
  isCertified     Boolean                                @default(false) @map("is_certified")
  isVerified      Boolean                                @default(false) @map("is_verified")
  isActive        Boolean                                @default(true) @map("is_active")
  ownerId         String?                                @map("owner_id") @db.Uuid
  owner           Profile?                               @relation("CenterOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt       DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("training_centers")
}
