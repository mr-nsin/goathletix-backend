generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditlog {
  user_id      String   @db.Uuid
  audio_s3_url String?  @db.VarChar
  transcript   String   @db.VarChar
  parsed_json  String   @db.VarChar
  id           String   @id @db.Uuid
  created_at   DateTime @db.Timestamp(6)
  user         user     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brokercredential {
  user_id            String  @db.Uuid
  fyers_app_id       String? @db.VarChar
  fyers_access_token String? @db.VarChar
  id                 String  @id @db.Uuid
  user               user    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order {
  user_id         String  @db.Uuid
  broker_order_id String? @db.VarChar
  symbol          String  @db.VarChar
  side            String  @db.VarChar
  quantity        Int
  status          String  @db.VarChar
  is_algo_trade   Boolean
  id              String  @id @db.Uuid
  user            user    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user {
  email             String             @unique(map: "ix_user_email") @db.VarChar
  subscription_tier String             @db.VarChar
  id                String             @id @db.Uuid
  created_at        DateTime           @db.Timestamp(6)
  auditlog          auditlog[]
  brokercredential  brokercredential[]
  order             order[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model virtualportfolio {
  id               Int   @id @default(autoincrement())
  total_capital    Float
  available_margin Float
  realized_pnl     Float
  unrealized_pnl   Float
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model virtualtrade {
  id            String    @id @db.Uuid
  strategy_name String    @db.VarChar
  symbol        String    @db.VarChar
  side          String    @db.VarChar
  quantity      Int
  entry_price   Float
  exit_price    Float?
  status        String    @db.VarChar
  pnl           Float
  created_at    DateTime  @db.Timestamp(6)
  closed_at     DateTime? @db.Timestamp(6)
}

// ==========================================
// GoAthletix Event Discovery Models
// ==========================================

model Organizer {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String               @unique
  websiteUrl    String?              @map("website_url")
  logoUrl       String?              @map("logo_url")
  isVerified    Boolean              @default(false) @map("is_verified")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  // Migration 0013. `slug` is backfilled from `name` and then held unique by organizers_slug_key.
  slug          String?              @unique(map: "organizers_slug_key")
  description   String?
  city          String?
  state         String?
  contactEmail  String?              @map("contact_email")
  contactPhone  String?              @map("contact_phone")
  instagramUrl  String?              @map("instagram_url")
  coverUrl      String?              @map("cover_url")
  sportTypes    SportCategory[]      @default([]) @map("sport_types")
  verifiedAt    DateTime?            @map("verified_at") @db.Timestamptz(6)
  claimedAt     DateTime?            @map("claimed_at") @db.Timestamptz(6)
  followerCount Int                  @default(0) @map("follower_count")
  eventCount    Int                  @default(0) @map("event_count")
  ratingAvg     Decimal?             @map("rating_avg") @db.Decimal(2, 1)
  ratingCount   Int                  @default(0) @map("rating_count")
  updatedAt     DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  events        Event[]
  follows       Follow[]
  members       OrganizerMember[]
  privateData   OrganizerPrivate?
  eventRequests EventRequest[]
  challenges    Challenge[]
  coupons       Coupon[]
  payouts       OrganizerPayout[]
  broadcasts    OrganizerBroadcast[]

  @@map("organizers")
}

model Event {
  id                   String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId             String                                 @unique @map("source_id")
  eventName            String                                 @map("event_name")
  sportType            SportCategory                          @map("sport_type")
  startDate            DateTime                               @map("start_date") @db.Date
  endDate              DateTime?                              @map("end_date") @db.Date
  city                 String
  state                String
  venue                String
  geoLocation          Unsupported("geography(Point, 4326)")? @map("geo_location")
  distanceOptions      String[]                               @map("distance_options")
  elevationGain        String?                                @map("elevation_gain")
  difficulty           DifficultyLevel                        @default(Intermediate)
  priceRange           String?                                @map("price_range")
  // Nullable since 0022: events with ticketing_mode = 'platform' have no external registration page
  // (CHECK events_registration_target enforces one or the other).
  registrationUrl      String?                                @map("registration_url")
  posterUrl            String?                                @map("poster_url")
  isPopular            Boolean                                @default(false) @map("is_popular")
  description          String?
  slug                 String?                                @unique
  ageCategories        AgeCategory[]                          @map("age_categories")
  disciplineSlugs      String[]                               @map("discipline_slugs")
  seriesId             String?                                @map("series_id") @db.Uuid
  series               EventSeries?                           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  clubId               String?                                @map("club_id") @db.Uuid
  club                 Club?                                  @relation(fields: [clubId], references: [id], onDelete: SetNull)
  isClubActivity       Boolean                                @default(false) @map("is_club_activity")
  organizerName        String?                                @map("organizer_name")
  registrationOpensAt  DateTime?                              @map("registration_opens_at") @db.Timestamptz(6)
  registrationClosesAt DateTime?                              @map("registration_closes_at") @db.Timestamptz(6)
  interestCount        Int                                    @default(0) @map("interest_count")
  viewCount            Int                                    @default(0) @map("view_count")
  featuredRank         Int?                                   @map("featured_rank")
  organizerId          String?                                @map("organizer_id") @db.Uuid
  organizer            Organizer?                             @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  terrain              String?
  isVirtual            Boolean                                @default(false) @map("is_virtual")
  status               EventStatus                            @default(upcoming)
  md5PayloadHash       String                                 @map("md5_payload_hash")
  createdAt            DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                               @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Migration 0014: event details and pricing. `certifyingBody` is CHECK-constrained to
  // 'AIMS' | 'World Athletics' | 'AFI' | 'state_association' | 'national_federation' | 'other'.
  startTime        DateTime? @map("start_time") @db.Time(6)
  timezone         String    @default("Asia/Kolkata")
  isCertified      Boolean   @default(false) @map("is_certified")
  certifyingBody   String?   @map("certifying_body")
  isChipTimed      Boolean   @default(false) @map("is_chip_timed")
  countsForRanking Boolean   @default(false) @map("counts_for_ranking")
  timingPartner    String?   @map("timing_partner")
  featuredUntil    DateTime? @map("featured_until") @db.Date
  priceMinInr      Int?      @map("price_min_inr")
  priceMaxInr      Int?      @map("price_max_inr")
  altitudeM        Int?      @map("altitude_m")
  courseMapUrl     String?   @map("course_map_url")
  ratingAvg        Decimal?  @map("rating_avg") @db.Decimal(2, 1)
  ratingCount      Int       @default(0) @map("rating_count")

  // Migration 0015. CHECK: 'venue' | 'city'. Maintained by the fill_event_geo_from_city trigger.
  geoPrecision String? @map("geo_precision")

  // Migration 0016.
  resultsUrl         String?       @map("results_url")
  resultsStatus      ResultsStatus @default(none) @map("results_status")
  resultsPublishedAt DateTime?     @map("results_published_at") @db.Timestamptz(6)

  // Migration 0022: visibility, publication and ticketing. CHECK-constrained text columns:
  //   visibility         'public' | 'unlisted' | 'private'
  //   publicationStatus  'draft' | 'published' | 'archived'
  //   ticketingMode      'external' | 'platform'
  //   feePaidBy          'buyer' | 'organizer'
  //   maxTicketsPerOrder 1..50
  visibility          String    @default("public")
  publicationStatus   String    @default("published") @map("publication_status")
  publishedAt         DateTime? @map("published_at") @db.Timestamptz(6)
  accessToken         String    @unique(map: "events_access_token_key") @default(dbgenerated("encode(gen_random_bytes(12), 'hex')")) @map("access_token")
  createdBy           String?   @map("created_by") @db.Uuid
  creator             Profile?  @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  ticketingMode       String    @default("external") @map("ticketing_mode")
  maxTicketsPerOrder  Int       @default(10) @map("max_tickets_per_order")
  platformFeePct      Decimal?  @map("platform_fee_pct") @db.Decimal(5, 2)
  feePaidBy           String    @default("buyer") @map("fee_paid_by")
  refundPolicy        String?   @map("refund_policy")
  certificateTemplate Json?     @map("certificate_template")

  follows            Follow[]
  userCalendars      UserCalendar[]
  reminders          Reminder[]
  interests          EventInterest[]
  results            EventResult[]
  categories         EventCategory[]
  submissionRequests EventRequest[]
  feedbacks          UserFeedback[]
  resultEntries      EventResultEntry[]
  reviews            EventReview[]
  media              EventMedia[]
  dailyStats         EventDailyStat[]
  collectionEvents   CollectionEvent[]
  relatedArticles    Article[]
  announcements      SiteAnnouncement[]
  formFields         EventFormField[]
  staff              EventStaff[]
  invites            EventInvite[]
  tickets            Ticket[]
  coupons            Coupon[]
  organizerPayouts   OrganizerPayout[]
  broadcasts         OrganizerBroadcast[]
  productClicks      ProductClick[]
  contextOrders      CheckoutOrder[]
  contextOrderItems  OrderItem[]

  // Indexes that exist in SQL but cannot be expressed here: idx_events_featured (partial, 0014),
  // idx_events_certified (partial, 0014), idx_events_results_published (partial, 0016),
  // idx_events_discoverable (partial, 0022), idx_events_price_min (plain btree, 0014).
  @@map("events")
}

model Profile {
  id                  String          @id @db.Uuid
  fullName            String?         @map("full_name")
  preferredLocation   String?         @map("preferred_location")
  sportsInterest      SportCategory[] @map("sports_interest")
  onboardingCompleted Boolean         @default(false) @map("onboarding_completed")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Migration 0013. Public-safe fields only; personal data lives in ProfilePrivate.
  // SQL also holds a case-insensitive unique index profiles_username_key ON (lower(username))
  // WHERE username IS NOT NULL, plus CHECK profiles_username_format (^[a-zA-Z0-9_.]{3,30}$).
  // Neither is expressible in Prisma, so uniqueness is NOT declared here.
  username            String?
  avatarUrl           String?         @map("avatar_url")
  bio                 String?
  city                String?
  state               String?
  isPublic            Boolean         @default(false) @map("is_public")

  follows         Follow[]
  userCalendars   UserCalendar[]
  reminders       Reminder[]
  eventRequests   EventRequest[]   @relation("EventRequestSubmitter")
  feedbacks       UserFeedback[]
  activityLogs    ActivityLog[]
  eventInterests  EventInterest[]
  eventResults    EventResult[]
  entityFollows   EntityFollow[]
  clubMemberships ClubMember[]
  ownedClubs      Club[]           @relation("ClubOwner")
  ownedCenters    TrainingCenter[] @relation("CenterOwner")
  sharedCalendars SharedCalendar[]

  privateData              ProfilePrivate?
  userRoles                UserRole[]               @relation("UserRoleUser")
  grantedRoles             UserRole[]               @relation("UserRoleGrantor")
  organizerMemberships     OrganizerMember[]
  reviewedEventRequests    EventRequest[]           @relation("EventRequestReviewer")
  createdEvents            Event[]                  @relation("EventCreator")
  claimedResultEntries     EventResultEntry[]
  resultClaims             ResultClaim[]            @relation("ResultClaimUser")
  reviewedResultClaims     ResultClaim[]            @relation("ResultClaimReviewer")
  eventReviews             EventReview[]
  uploadedMedia            EventMedia[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  pushSubscriptions        PushSubscription[]
  alertSubscriptions       AlertSubscription[]
  createdCollections       Collection[]
  articles                 Article[]
  challengeParticipations  ChallengeParticipant[]
  ownedSellers             Seller[]                 @relation("SellerOwner")
  sellerMemberships        SellerMember[]
  reviewedProducts         Product[]                @relation("ProductReviewedBy")
  productModerationActions ProductModerationLog[]
  productClicks            ProductClick[]
  addresses                UserAddress[]
  productSaves             ProductSave[]
  cart                     Cart?
  orders                   CheckoutOrder[]
  returnRequests           ReturnRequest[]
  couponRedemptions        CouponRedemption[]
  productReviews           ProductReview[]
  ticketsBought            Ticket[]                 @relation("TicketBuyer")
  ticketsAttending         Ticket[]                 @relation("TicketAttendee")
  ticketsCheckedIn         Ticket[]                 @relation("TicketCheckedInBy")
  eventStaffRoles          EventStaff[]
  invitesReceived          EventInvite[]            @relation("EventInviteUser")
  invitesSent              EventInvite[]            @relation("EventInviteSender")
  broadcastsCreated        OrganizerBroadcast[]

  @@map("profiles")
}

model Follow {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  profile     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  FollowTarget @map("target_type")
  organizerId String?      @map("organizer_id") @db.Uuid
  organizer   Organizer?   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  eventId     String?      @map("event_id") @db.Uuid
  event       Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, organizerId], name: "unique_user_follow_organizer")
  @@unique([userId, eventId], name: "unique_user_follow_event")
  @@map("follows")
}

model UserCalendar {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, eventId], name: "unique_user_event_calendar")
  @@map("user_calendars")
}

model Reminder {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  profile     Profile             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     String              @map("event_id") @db.Uuid
  event       Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggerType ReminderType        @map("trigger_type")
  isTriggered Boolean             @default(false) @map("is_triggered")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  // Migration 0018. idx_reminders_due (partial: WHERE NOT is_triggered) exists in SQL only.
  channel     NotificationChannel @default(in_app)
  sendAt      DateTime?           @map("send_at") @db.Timestamptz(6)

  @@unique([userId, eventId, triggerType], name: "unique_user_event_reminder")
  @@map("reminders")
}

model EventRequest {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  profile         Profile?      @relation("EventRequestSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  eventName       String        @map("event_name")
  sportType       SportCategory @map("sport_type")
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  city            String
  state           String
  venue           String
  registrationUrl String        @map("registration_url")
  description     String?
  organizerName   String        @map("organizer_name")
  status          RequestStatus @default(pending)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  // Migration 0013 (#17 event submission).
  organizerId     String?       @map("organizer_id") @db.Uuid
  organizer       Organizer?    @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  distanceOptions String[]      @default([]) @map("distance_options")
  priceRange      String?       @map("price_range")
  posterUrl       String?       @map("poster_url")
  startTime       DateTime?     @map("start_time") @db.Time(6)
  ageCategories   AgeCategory[] @default([]) @map("age_categories")
  disciplineSlugs String[]      @default([]) @map("discipline_slugs")
  contactEmail    String?       @map("contact_email")
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewer        Profile?      @relation("EventRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNotes     String?       @map("review_notes")
  createdEventId  String?       @map("created_event_id") @db.Uuid
  createdEvent    Event?        @relation(fields: [createdEventId], references: [id], onDelete: SetNull)

  @@map("event_requests")
}

model UserFeedback {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?      @map("user_id") @db.Uuid
  profile      Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  feedbackType FeedbackType @map("feedback_type")
  message      String
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  // Migration 0013 (listing corrections). idx_user_feedbacks_event is partial, SQL only.
  eventId      String?      @map("event_id") @db.Uuid
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  pageUrl      String?      @map("page_url")

  @@map("user_feedbacks")
}

model ActivityLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  profile         Profile?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userDisplayName String?        @map("user_display_name")
  actionType      ActivityAction @map("action_type")
  targetId        String         @map("target_id") @db.Uuid
  targetName      String         @map("target_name")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  // Migration 0018. idx_activity_logs_recent (partial: WHERE is_public) exists in SQL only.
  actorCity       String?        @map("actor_city")
  isPublic        Boolean        @default(true) @map("is_public")

  @@map("activity_logs")
}

enum SportCategory {
  running
  cycling
  triathlon
  trekking
  fitness
  racquet
  water
  adventure
  // Added 2026-09-16 by migration 0005 (ADR-006). Order matches pg_enum sort order; Postgres
  // cannot reorder or remove enum values, so append only.
  athletics
  skating
  gymnastics
  martial_arts
  team_sports
  mind_sports

  @@map("sport_category")
}

enum EventStatus {
  upcoming
  closed
  completed
  cancelled
  // Migration 0012.
  postponed

  @@map("event_status")
}

enum DifficultyLevel {
  Beginner
  Intermediate
  Advanced
  Expert

  @@map("difficulty_level")
}

enum FollowTarget {
  organizer
  event

  @@map("follow_target")
}

enum ReminderType {
  registration_open
  registration_close
  event_date

  @@map("reminder_type")
}

enum RequestStatus {
  pending
  approved
  rejected

  @@map("request_status")
}

enum FeedbackType {
  feature_request
  general_feedback
  bug_report
  // Migration 0012.
  listing_correction

  @@map("feedback_type")
}

enum ActivityAction {
  save
  follow
  calendar_add
  // Migration 0012.
  interest
  going
  review
  result_published
  event_listed
  registered

  @@map("activity_action")
}

// ---------------------------------------------------------------------------
// Taxonomy, clubs and engagement — migrations 0006-0011 (ADR-006).
// ---------------------------------------------------------------------------

enum SportFamily {
  athletics
  endurance
  skill_artistic
  combat
  racquet
  outdoor
  fitness
  team
  mind

  @@map("sport_family")
}

enum EventModel {
  mass_participation
  meet
  bracket
  batch_departure
  non_competitive
  league_fixture

  @@map("event_model")
}

enum DisciplineKind {
  sport
  format

  @@map("discipline_kind")
}

enum AgeCategory {
  kids
  sub_junior
  junior
  youth
  open
  masters

  @@map("age_category")
}

enum RecurrenceKind {
  none
  weekly
  monthly
  seasonal
  annual

  @@map("recurrence_kind")
}

enum ClubRole {
  owner
  admin
  member

  @@map("club_role")
}

enum MembershipStatus {
  pending
  active
  left
  removed

  @@map("membership_status")
}

enum InterestStatus {
  saved
  interested
  going
  attended
  skipped
  // Migration 0012.
  waitlisted

  @@map("interest_status")
}

enum FollowEntity {
  event
  organizer
  club
  training_center
  user
  // Migration 0012.
  seller

  @@map("follow_entity")
}

model Sport {
  slug         SportCategory @id
  displayName  String        @map("display_name")
  family       SportFamily
  eventModel   EventModel    @map("event_model")
  phase        Int           @default(9) @db.SmallInt
  isActive     Boolean       @default(false) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Migration 0014.
  heroImageUrl String?       @map("hero_image_url")
  icon         String?
  description  String?
  disciplines  Discipline[]
  series       EventSeries[]

  @@map("sports")
}

model Discipline {
  slug            String          @id
  displayName     String          @map("display_name")
  sportType       SportCategory   @map("sport_type")
  sport           Sport           @relation(fields: [sportType], references: [slug])
  kind            DisciplineKind  @default(sport)
  aliases         String[]
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Migration 0014.
  displayOrder    Int             @default(100) @map("display_order")
  isFeatured      Boolean         @default(false) @map("is_featured")
  eventCategories EventCategory[]

  @@map("disciplines")
}

model EventSeries {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  slug           String?        @unique
  description    String?
  sportType      SportCategory  @map("sport_type")
  sport          Sport          @relation(fields: [sportType], references: [slug])
