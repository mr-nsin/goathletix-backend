// ---------------------------------------------------------------------------
// Event details and pricing — migration 0014 (event_categories is extended by 0022).
// ---------------------------------------------------------------------------

/// A ticket type / race category. CHECKs: gender IN ('open','female','male','mixed'); distance_km > 0;
/// cutoff_minutes > 0; capacity > 0; slots_taken >= 0; price_inr >= 0; max_per_order > 0.
/// slots_taken and is_sold_out are maintained by the refresh_ticket_counts trigger (0022).
model EventCategory {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  label          String
  disciplineSlug String?       @map("discipline_slug")
  discipline     Discipline?   @relation(fields: [disciplineSlug], references: [slug], onDelete: SetNull)
  distanceKm     Decimal?      @map("distance_km") @db.Decimal(7, 3)
  ageCategories  AgeCategory[] @default([]) @map("age_categories")
  gender         String        @default("open")
  startTime      DateTime?     @map("start_time") @db.Time(6)
  cutoffMinutes  Int?          @map("cutoff_minutes")
  capacity       Int?
  slotsTaken     Int?          @map("slots_taken")
  priceInr       Int?          @map("price_inr")
  isSoldOut      Boolean       @default(false) @map("is_sold_out")
  sortOrder      Int           @default(0) @map("sort_order")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Migration 0022.
  description    String?
  includes       String[]      @default([])
  salesStartAt   DateTime?     @map("sales_start_at") @db.Timestamptz(6)
  salesEndAt     DateTime?     @map("sales_end_at") @db.Timestamptz(6)
  maxPerOrder    Int?          @map("max_per_order")
  isHidden       Boolean       @default(false) @map("is_hidden")

  priceTiers        EventPriceTier[]
  waves             EventWave[]
  formFields        EventFormField[]
  tickets           Ticket[]
  resultEntries     EventResultEntry[]
  unlockedByCoupons Coupon[]

  @@unique([eventId, label])
  @@map("event_categories")
}

/// CHECKs: price_inr >= 0; valid_until >= valid_from when both are set.
model EventPriceTier {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId String        @map("category_id") @db.Uuid
  category   EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label      String
  priceInr   Int           @map("price_inr")
  validFrom  DateTime?     @map("valid_from") @db.Date
  validUntil DateTime?     @map("valid_until") @db.Date
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  tickets    Ticket[]

  @@map("event_price_tiers")
}

