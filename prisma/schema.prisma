  sportTypes       SportCategory[]     @default([]) @map("sport_types")
  confirmedAt      DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  unsubscribeToken String              @unique @default(dbgenerated("encode(gen_random_bytes(16), 'hex')")) @map("unsubscribe_token")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("alert_subscriptions")
}

