  athleteName      String                   @map("athlete_name")
  gender           String?
  ageGroup         String?                  @map("age_group")
  clubName         String?                  @map("club_name")
  city             String?
  finishStatus     FinishStatus             @default(finished) @map("finish_status")
  // `interval` has no Prisma mapping (same as EventResult.finishTime): raw query / REST only.
  gunTime          Unsupported("interval")? @map("gun_time")
  chipTime         Unsupported("interval")? @map("chip_time")
  positionOverall  Int?                     @map("position_overall")
  positionGender   Int?                     @map("position_gender")
  positionCategory Int?                     @map("position_category")
  source           String
  sourceRowHash    String                   @map("source_row_hash")
  isHidden         Boolean                  @default(false) @map("is_hidden")
  claimedBy        String?                  @map("claimed_by") @db.Uuid
  claimant         Profile?                 @relation(fields: [claimedBy], references: [id], onDelete: SetNull)
  claimedAt        DateTime?                @map("claimed_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  claims           ResultClaim[]

  @@unique([eventId, source, sourceRowHash])
  @@map("event_result_entries")
}

model ResultClaim {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId      String           @map("entry_id") @db.Uuid
  entry        EventResultEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId       String           @map("user_id") @db.Uuid
  user         Profile          @relation("ResultClaimUser", fields: [userId], references: [id], onDelete: Cascade)
  status       RequestStatus    @default(pending)
  evidenceNote String?          @map("evidence_note")
  reviewedBy   String?          @map("reviewed_by") @db.Uuid
  reviewer     Profile?         @relation("ResultClaimReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([entryId, userId])
  @@map("result_claims")
}

