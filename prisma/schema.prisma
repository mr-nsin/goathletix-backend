/// Timing-partner results, distinct from the user-entered EventResult. CHECKs: gender IN
/// ('female','male','other'); position_* > 0. Also in SQL only: idx_result_entries_name
/// (expression index on lower(athlete_name)) and the partial idx_result_entries_claimed.
model EventResultEntry {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String                   @map("event_id") @db.Uuid
  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId       String?                  @map("category_id") @db.Uuid
  category         EventCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
